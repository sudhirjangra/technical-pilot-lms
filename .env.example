# Root environment variables for shared @repo/config package
# This file is read by the config package at build time
# Copy to .env and modify values as needed

# Configuration (shared @repo/config)
# Max devices per user (default: 2)
MAX_DEVICES_PER_USER=4
# Session timeout in days (default: 3)
SESSION_TIMEOUT_DAYS=3
# Access token expiration in minutes (default: 15)
ACCESS_TOKEN_EXPIRATION_MINUTES=15
# Refresh token expiration in days (default: 30)
REFRESH_TOKEN_EXPIRATION_DAYS=30

# UI Configuration
# Sign-in card max width (default: 24rem)
SIGN_IN_CARD_MAX_WIDTH=24rem
# Sign-in card padding (default: 1.5rem)
SIGN_IN_CARD_PADDING=1.5rem
# Form gap (default: 1.25rem)
FORM_GAP=1.25rem
# Input gap (default: 0.5rem)
INPUT_GAP=0.5rem
# Button height (default: 2.5rem)
BUTTON_HEIGHT=2.5rem

# App Configuration
APP_NAME=Technical Pilot LMS
APP_VERSION=1.0.0
APP_LOGO_URL=