{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "API_URL",
        "AUTH_SESSION_AGE",
        "AUTH_SECRET",
        "AUTH_URL",
        "NODE_ENV",
        "SUPABASE_SECRET_KEY",
        "MAX_DEVICES_PER_USER",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SESSION_TIMEOUT_DAYS",
        "ACCESS_TOKEN_EXPIRATION_MINUTES",
        "REFRESH_TOKEN_EXPIRATION_DAYS",
        "APP_NAME",
        "APP_VERSION",
        "HOST",
        "ALLOW_CORS_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": false,
      "outputLogs": "full"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["^start"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^test"]
    }
  }
}
