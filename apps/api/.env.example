# Server Configuration
HOST=localhost
PORT=8000
NODE_ENV=development
ALLOW_CORS_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Tokens (app-level, not Supabase JWT)
ACCESS_TOKEN_SECRET=your-access-token-secret-min-10-chars
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-10-chars
REFRESH_TOKEN_EXPIRATION=30d

# Configuration (shared @repo/config)
# Max devices per user (default: 2)
MAX_DEVICES_PER_USER=4
# Session timeout in days (default: 3)
SESSION_TIMEOUT_DAYS=3
# Access token expiration in minutes (default: 15)
ACCESS_TOKEN_EXPIRATION_MINUTES=15
# Refresh token expiration in days (default: 30)
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Mail (Resend)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
MAIL_FROM=noreply@yourdomain.com

# Password Reset Redirect URL (frontend URL for reset password page)
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# File Storage
FILE_MAX_SIZE=20971520

# Razorpay (leave empty in dev to skip payment validation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# VdoCipher — Dashboard → Config → API Secret Key (NEVER expose to client)
VDOCIPHER_API_SECRET=
VDOCIPHER_OTP_TTL_SECONDS=300
