# API Base URL
API_URL=http://localhost:8000/api
# Public API base URL (used by the browser for large direct uploads, e.g. videos)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Supabase (public keys for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Authentication (NextAuth)
AUTH_SESSION_AGE=7776000
AUTH_SECRET=generate-a-secure-random-string
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Configuration (shared @repo/config)
# Max devices per user (default: 2)
MAX_DEVICES_PER_USER=4
# Session timeout in days (default: 3)
SESSION_TIMEOUT_DAYS=3
# Access token expiration in minutes (default: 15)
ACCESS_TOKEN_EXPIRATION_MINUTES=15
# Refresh token expiration in days (default: 30)
REFRESH_TOKEN_EXPIRATION_DAYS=30

# UI Configuration
# Sign-in card max width (default: 24rem)
SIGN_IN_CARD_MAX_WIDTH=24rem
# Sign-in card padding (default: 1.5rem)
SIGN_IN_CARD_PADDING=1.5rem
# Form gap (default: 1.25rem)
FORM_GAP=1.25rem
# Input gap (default: 0.5rem)
INPUT_GAP=0.5rem
# Button height (default: 2.5rem)
BUTTON_HEIGHT=2.5rem

# App Configuration
APP_NAME=Technical Pilot LMS
APP_VERSION=1.0.0
APP_LOGO_URL=
